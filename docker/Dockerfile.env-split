# Dockerfile.env 와 같은 이미지를 **레이어를 셋으로 나눠** 만든다 — 큰 레이어 하나의 blob 커밋이 GHCR 에서 거부될 때 쓴다
# (2026-11-04 wham: 단일 /workspace 레이어 push 39분 뒤 "failed commit on ref layer-sha256:…: unexpected status from PUT").
#   ① micromamba/ (환경 + 바이너리)   ② repos/<REPO> 에서 체크포인트를 뺀 것   ③ repos/<REPO>/checkpoints
# 세 레이어의 합은 단일 레이어와 같은 파일 집합이고, 제외 목록(TAR_EXCLUDES)과 부재 검증도 같다.
#
#   docker build --platform linux/amd64 -f docker/Dockerfile.env-split --build-arg ENV_TAR=wham_env_20261008_2b54f77.tar.zst \
#       --build-arg REPO=WHAM --build-arg TAR_EXCLUDES="repos/WHAM/dataset/body_models/smpl …" \
#       --build-context archives=$HOME/data/_env_archives -t ghcr.io/<ns>/v2ua-wham:<태그> .
FROM ubuntu:24.04

ARG ENV_TAR
ARG REPO
ARG TAR_EXCLUDES=""
RUN test -n "$ENV_TAR" -a -n "$REPO" || (echo "ENV_TAR · REPO 빌드 인자가 필요하다" && exit 1)

# python3: 오케스트레이터(scripts/orchestrate.py)는 시스템 python3 로 돈다 — 2026-11-05 검증에서 없음을 확인(이미지 갭 ①)
RUN apt-get update && apt-get install -y --no-install-recommends zstd ca-certificates git ffmpeg libgl1 libglib2.0-0 python3 \
    && rm -rf /var/lib/apt/lists/*

# ① 환경
RUN --mount=type=bind,from=archives,source=${ENV_TAR},target=/tmp/env.tar.zst \
    mkdir -p /workspace && tar --use-compress-program="zstd -d -T0" -xf /tmp/env.tar.zst -C /workspace micromamba \
    && ls /workspace/micromamba/envs
# ② 레포 (체크포인트 제외 + 재배포 금지 제외)
RUN --mount=type=bind,from=archives,source=${ENV_TAR},target=/tmp/env.tar.zst \
    EX="--exclude=repos/${REPO}/checkpoints"; for p in $TAR_EXCLUDES; do EX="$EX --exclude=$p"; done; \
    tar --use-compress-program="zstd -d -T0" $EX -xf /tmp/env.tar.zst -C /workspace repos \
    && for p in $TAR_EXCLUDES; do test ! -e "/workspace/$p" || (echo "제외 실패: $p" && exit 1); done
# ③ 체크포인트 — 큰 파일은 따로 한 레이어씩 (CKPT_A · CKPT_B: 파일 이름, 공백 구분), 나머지는 마지막 한 레이어.
#    2026-11-05: 체크포인트 6.46GB 를 한 레이어로 push 하면 38분 뒤 커밋이 400 으로 거부됐다 (trellis2 5.98GB 압축 레이어는 통과).
ARG CKPT_A=""
ARG CKPT_B=""
RUN --mount=type=bind,from=archives,source=${ENV_TAR},target=/tmp/env.tar.zst \
    for f in $CKPT_A; do tar --use-compress-program="zstd -d -T0" -xf /tmp/env.tar.zst -C /workspace "repos/${REPO}/checkpoints/$f"; done
RUN --mount=type=bind,from=archives,source=${ENV_TAR},target=/tmp/env.tar.zst \
    for f in $CKPT_B; do tar --use-compress-program="zstd -d -T0" -xf /tmp/env.tar.zst -C /workspace "repos/${REPO}/checkpoints/$f"; done
RUN --mount=type=bind,from=archives,source=${ENV_TAR},target=/tmp/env.tar.zst \
    if tar --use-compress-program="zstd -d -T0" -tf /tmp/env.tar.zst "repos/${REPO}/checkpoints" >/dev/null 2>&1; then \
      EX=""; for f in $CKPT_A $CKPT_B; do EX="$EX --exclude=repos/${REPO}/checkpoints/$f"; done; \
      tar --use-compress-program="zstd -d -T0" $EX -xf /tmp/env.tar.zst -C /workspace "repos/${REPO}/checkpoints"; fi \
    && for p in $TAR_EXCLUDES; do test ! -e "/workspace/$p" || (echo "제외 실패: $p" && exit 1); done \
    && ls -la /workspace/repos/${REPO}/checkpoints

# 환경 이름 별칭 ("별칭:실제 …", 공백 구분). 오케스트레이터는 S2 를 `-n sam2` 로 부르는데 아카이브 환경은 sam2v 라
# 심링크로 잇는다 (2026-11-05 검증에서 "The given prefix does not exist: …/envs/sam2" — 이미지 갭 ②).
# CUDA 런타임 심링크: pip torch(cu118 등)는 libnvrtc-<hash>.so.11.x 를 같이 담지만 cuDNN 이 dlopen 하는 이름은 libnvrtc.so 다.
# RunPod CUDA 베이스에서는 /usr/local/cuda 가 그 이름을 제공했고, 이 Ubuntu 베이스에는 없어 WHAM demo 가 "Could not load library
# libcudnn_cnn_infer.so.8 … libnvrtc.so" 로 죽는다 (2026-11-05 검증, 이미지 갭 ③). 환경 안의 사본을 시스템 이름으로 잇는다.
RUN for f in /workspace/micromamba/envs/*/lib/python*/site-packages/torch/lib/libnvrtc-*.so.*; do       [ -e "$f" ] || continue; ln -sf "$f" /usr/local/lib/libnvrtc.so; echo "libnvrtc.so -> $f"; done; ldconfig
ARG ENV_ALIAS=""
RUN for a in $ENV_ALIAS; do ln -s "${a#*:}" "/workspace/micromamba/envs/${a%%:*}" && ls -la "/workspace/micromamba/envs/${a%%:*}"; done
ENV MAMBA_ROOT_PREFIX=/workspace/micromamba \
    PATH=/workspace/micromamba/bin:$PATH \
    PYTHONUNBUFFERED=1
LABEL org.opencontainers.image.source="https://github.com/chaeee01/Video2UnityAvatar-Pipeline" \
      v2ua.env_archive="${ENV_TAR}"
WORKDIR /workspace
CMD ["bash"]

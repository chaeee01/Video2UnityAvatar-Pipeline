# 통합 이미지 v2ua-all — 환경 3종(sam2 · trellis2 · wham)을 한 이미지에 (2026-11-07).
# wham v2(sshd · start.sh 포함)를 바탕으로 sam2v · trellis2 v2 이미지의 환경과 레포만 복사한다. 세 이미지 모두 같은 아카이브 ·
# 같은 제외 규칙(Dockerfile.env · Dockerfile.env-split)으로 지었고, /workspace 아래에서 겹치는 것은 내용이 같은
# micromamba 바이너리(2.8.1, sha256 77b7790e…)뿐이라 환경 · 레포만 옮긴다. 시작 스크립트 · 별칭 · libnvrtc 링크는 그대로다.
#
#   docker build --platform linux/amd64 -f docker/Dockerfile.all \
#       --build-arg WHAM=ghcr.io/<ns>/v2ua-wham:v2-… --build-arg SAM2V=ghcr.io/<ns>/v2ua-sam2v:v2-… \
#       --build-arg TRELLIS2=ghcr.io/<ns>/v2ua-trellis2:v2-… -t ghcr.io/<ns>/v2ua-all:v2-<날짜>-<커밋> .
#
# libnvrtc: wham 의 /usr/local/lib/libnvrtc.so(torch cu118 동봉 11.2) 링크가 이미지 전체에 걸린다. sam2 · trellis2 는 링크가
# 없던 이미지에서 검증됐으므로 영향은 in-image 검사와 §15 GPU 검증에서 본다.
ARG WHAM
ARG SAM2V
ARG TRELLIS2
FROM ${SAM2V} AS sam2v
FROM ${TRELLIS2} AS trellis2
FROM ${WHAM}
# FROM 뒤에서 라벨에 쓰려면 다시 선언해야 한다
ARG WHAM
ARG SAM2V
ARG TRELLIS2
COPY --from=sam2v /workspace/micromamba/envs/ /workspace/micromamba/envs/
COPY --from=sam2v /workspace/repos/sam2 /workspace/repos/sam2
COPY --from=trellis2 /workspace/micromamba/envs/trellis2 /workspace/micromamba/envs/trellis2
COPY --from=trellis2 /workspace/repos/TRELLIS.2 /workspace/repos/TRELLIS.2
# 환경 4개(sam2 별칭 포함) · SMPL 계열 3종 부재(Dockerfile.env-split 의 TAR_EXCLUDES 와 같은 경로)를 빌드에서 확인한다
RUN ls /workspace/micromamba/envs && for e in sam2 sam2v trellis2 wham; do test -e /workspace/micromamba/envs/$e || (echo "환경 없음: $e" && exit 1); done \
    && for p in repos/WHAM/dataset/body_models/smpl repos/WHAM/dataset/body_models/smplx2smpl.pkl repos/WHAM/dataset/body_models/smpl_mean_params.npz; do \
         test ! -e "/workspace/$p" || (echo "제외 실패: $p" && exit 1); done
LABEL v2ua.image_version="v2-all" v2ua.components="${WHAM} ${SAM2V} ${TRELLIS2}" \
      v2ua.note_vitpose_testdata="repos/WHAM/third-party/ViTPose/tests/data/smpl/smpl_mean_params.npz 유지 — 공개 레포(ViTPose/mmpose) 자체 배포 시험 데이터, 비공개 레지스트리. 이미지 공개 전환 시 재검토"
